{
  "model": "claude-opus-5",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "switchModelsOnFlag": false,
  "autoMemoryEnabled": true,
  "agentPushNotifEnabled": true,
  "enableAllProjectMcpServers": true,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "defaultMode": "auto",	  
    "allow": [
      "Read",
      "Edit(**)",
      "Write(**)",
      "mcp__aligned-elements",
      "mcp__roxtra-mcp",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(nl *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(cd *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(column *)",
      "Bash(diff *)",
      "Bash(comm *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(xargs wc *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git show *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git rm *)",
      "Bash(git -C * status *)",
      "Bash(git -C * log *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * branch *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * show *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.npmrc)",
      "Read(~/.claude/.credentials.json)",
      "Bash(cmdkey *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{REPO}}/cc.py\" check --daily --quiet --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
